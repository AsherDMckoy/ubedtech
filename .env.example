# Copy to .env for local development only. Values from .env never override
# real environment variables, so production deployments set real env vars.
# Secrets belong in the deployment's secret store, never in this file.

# development | production (default: development)
APP_ENV=development

# Required. Local dev example — adjust user/host/db to your setup. No secrets here.
DATABASE_URL=postgresql://localhost:5432/ubedtechdb

# Optional overrides (defaults shown).
#APP_BIND_ADDR=0.0.0.0:8080
#APP_DB_MAX_CONNECTIONS=64
#APP_DB_MIN_CONNECTIONS=8
#APP_DB_ACQUIRE_TIMEOUT_SECS=5
#APP_DOCUMENT_STORAGE_PATH=./var/documents
#APP_WORKER_ID=document-worker-1
#APP_SHUTDOWN_TIMEOUT_SECS=30
#APP_READINESS_INTERVAL_SECS=5

# Argon2id password-hashing cost (defaults follow the OWASP recommendation:
# 19 MiB memory, 2 iterations, 1 lane). Parameters travel inside each stored
# hash, so changing these only affects newly set passwords.
#APP_ARGON2_MEMORY_KIB=19456
#APP_ARGON2_TIME_COST=2
#APP_ARGON2_PARALLELISM=1

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,actix_web=info,sqlx=warn
